/* ============================================================
   MEGA TURRICAN MAKER — editor.rcss
   Visual target: Mega Turrican Reborn pixel-art game UI
   (Image 2 reference — black base, cyan/pink/amber accents,
   heavy inset-bevel borders, dense monospace label treatment)
   RmlUi 4 — no border-radius, no box-shadow, no gradients
   ============================================================ */

/* ── RESET ───────────────────────────────────────────────── */
* { box-sizing: border-box; }

body {
  margin: 0;
  padding: 0;
  width: 100%;
  height: 100%;
  color: #c8dff5;
  background-color: #000000;
  font-family: Courier New;
  font-size: 10px;
}

/* ── ROOT APP SHELL ──────────────────────────────────────── */
.maker-app {
  position: absolute;
  left: 0; top: 0;
  width: 100%; height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: #000000;
}

/* ============================================================
   TOP BAR
   ============================================================ */
.topbar {
  height: 50px;
  min-height: 50px;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 8px;
  gap: 6px;
  background-color: #0a0a0a;
  border-bottom: 3px #ff7700;
}

/* Logo block — amber filled diamond-clip shape */
.brand-mark {
  width: 38px;
  min-width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #ff7700;
  border-top: 2px #ffbb44;
  border-left: 2px #ffbb44;
  border-bottom: 2px #883300;
  border-right: 2px #883300;
  color: #000000;
  font-size: 13px;
  font-weight: 700;
}

.brand-block {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 1px;
  padding-right: 10px;
  border-right: 1px #2a2a2a;
}

.brand-title {
  color: #ff7700;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 2px;
}

.brand-era {
  color: #445566;
  font-size: 8px;
  letter-spacing: 1px;
}

.brand-file {
  color: #00d4ff;
  font-size: 9px;
  letter-spacing: 1px;
}

/* Menu strip */
.menu-strip {
  display: flex;
  flex-direction: row;
  gap: 0;
  border-right: 1px #2a2a2a;
  padding-right: 6px;
  margin-right: 2px;
}

.menu-item {
  height: 100%;
  padding: 0 10px;
  color: #667788;
  background-color: transparent;
  border: 1px transparent;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1px;
}

.menu-item:hover {
  color: #c8dff5;
  background-color: #111111;
  border-color: #333333;
}

/* Global mode toggle */
.mode-toggle {
  padding: 7px 12px;
  color: #00d4ff;
  background-color: #001a22;
  border-top: 2px #004466;
  border-left: 2px #004466;
  border-bottom: 2px #000d11;
  border-right: 2px #000d11;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1px;
}

.mode-toggle.active {
  color: #000000;
  background-color: #00d4ff;
  border-top-color: #88eeff;
  border-left-color: #88eeff;
  border-bottom-color: #005566;
  border-right-color: #005566;
}

.top-spacer { flex-grow: 1; }

/* Action buttons */
.button {
  padding: 7px 12px;
  color: #c8dff5;
  background-color: #111111;
  border-top: 2px #334455;
  border-left: 2px #334455;
  border-bottom: 2px #000000;
  border-right: 2px #000000;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1px;
}

.button:hover {
  color: #ffffff;
  background-color: #1a1a1a;
  border-top-color: #446677;
  border-left-color: #446677;
}

.button.primary {
  color: #000000;
  background-color: #ff7700;
  border-top-color: #ffbb44;
  border-left-color: #ffbb44;
  border-bottom-color: #883300;
  border-right-color: #883300;
}

.button.primary:hover {
  background-color: #ff9933;
}

.icon-button {
  width: 34px;
  padding: 7px 0;
  font-size: 14px;
  text-align: center;
}

/* Playtest — hot red */
.playtest {
  color: #ffffff;
  background-color: #880000;
  border-top-color: #cc2200;
  border-left-color: #cc2200;
  border-bottom-color: #330000;
  border-right-color: #330000;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  padding: 7px 18px;
}

.playtest:hover {
  background-color: #aa0000;
}

/* ============================================================
   WORKSPACE GRID
   ============================================================ */
.workspace {
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: 0%;
  min-height: 0;
  display: flex;
  flex-direction: row;
  gap: 3px;
  padding: 3px;
  overflow: hidden;
  background-color: #050505;
}

/* ============================================================
   LEFT TOOL RAIL
   ============================================================ */
.tool-rail {
  width: 88px;
  min-width: 88px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 3px;
  padding: 6px 5px;
  background-color: #0a0a0a;
  border-top: 2px #334455;
  border-left: 2px #334455;
  border-bottom: 2px #000000;
  border-right: 2px #000000;
}

.rail-caption {
  color: #ff7700;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 2px;
  text-align: center;
  padding: 3px 0 7px;
  border-bottom: 1px #221100;
  margin-bottom: 2px;
}

/* Tool buttons — physical pressed-button look */
.tool-button {
  height: 44px;
  min-height: 44px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  color: #445566;
  background-color: #111111;
  border-top: 2px #334455;
  border-left: 2px #334455;
  border-bottom: 2px #000000;
  border-right: 2px #000000;
  font-size: 7px;
  font-weight: 700;
  letter-spacing: 1px;
}

.tool-button:hover {
  color: #c8dff5;
  background-color: #161616;
  border-top-color: #446688;
  border-left-color: #446688;
}

.tool-button.active {
  color: #ff7700;
  background-color: #0d0800;
  border-top-color: #000000;
  border-left-color: #000000;
  border-bottom-color: #331a00;
  border-right-color: #331a00;
}

.tool-glyph {
  font-size: 16px;
  line-height: 17px;
  color: #334455;
}

.tool-button:hover .tool-glyph { color: #00d4ff; }
.tool-button.active .tool-glyph { color: #ff7700; }

.rail-spacer { flex-grow: 1; }

.rail-actions {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding-top: 4px;
  border-top: 1px #221100;
}

.rail-mini-button {
  height: 22px;
  min-height: 22px;
  color: #667788;
  background-color: #0d0d0d;
  border-top: 1px #334455;
  border-left: 1px #334455;
  border-bottom: 1px #000000;
  border-right: 1px #000000;
  font-size: 7px;
  font-weight: 700;
  letter-spacing: 1px;
}

.rail-mini-button:hover { color: #c8dff5; background-color: #141414; }
.rail-mini-button.rail-save { color: #ff7700; border-top-color: #442200; border-left-color: #442200; }
.rail-mini-button.rail-exit { color: #ff4455; border-top-color: #440011; border-left-color: #440011; }

.rail-foot {
  color: #223344;
  font-size: 7px;
  text-align: center;
  padding: 3px 0 0;
  letter-spacing: 1px;
}

/* ============================================================
   CENTER STAGE DOCK
   ============================================================ */
.center-dock {
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: 0%;
  min-width: 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
  gap: 3px;
  overflow: hidden;
}

/* Mode tabs — Reborn pixel-art tab style */
.center-tabs {
  height: 32px;
  min-height: 32px;
  display: flex;
  flex-direction: row;
  gap: 2px;
}

.center-tab {
  flex-grow: 1;
  color: #334455;
  background-color: #0a0a0a;
  border-top: 2px #223344;
  border-left: 2px #223344;
  border-bottom: 2px #000000;
  border-right: 2px #000000;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1px;
}

.center-tab.active {
  color: #000000;
  background-color: #00d4ff;
  border-top-color: #88eeff;
  border-left-color: #88eeff;
  border-bottom-color: #005566;
  border-right-color: #005566;
}

.center-tab:hover {
  color: #c8dff5;
  background-color: #111111;
  border-top-color: #334455;
  border-left-color: #334455;
}

/* Stage header bar */
.stage-head {
  height: 26px;
  min-height: 26px;
  display: flex;
  align-items: center;
  padding: 0 8px;
  background-color: #050505;
  border-top: 1px #1a1a1a;
  border-bottom: 1px #1a1a1a;
}

.stage-title {
  color: #ff7700;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 2px;
}

.accent-cyan { color: #00d4ff; }

.stage-head-right {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 6px;
  color: #334455;
  font-size: 8px;
  letter-spacing: 1px;
}

.separator { color: #222222; }

/* Toggle buttons in stage header */
.tiny-button {
  padding: 2px 6px;
  color: #334455;
  background-color: #0d0d0d;
  border: 1px #223344;
  font-size: 7px;
  font-weight: 700;
  letter-spacing: 1px;
}

.tiny-button.active {
  color: #00d4ff;
  background-color: #001a22;
  border-color: #004466;
}

.tiny-button:hover { color: #c8dff5; }

/* ── STAGE VIEWPORT ───────────────────────────────────────── */
.stage-viewport {
  position: relative;
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: 0%;
  width: 100%;
  min-height: 0;
  overflow: hidden;
  background-color: #050810;
  border-top: 2px #000000;
  border-left: 2px #000000;
  border-bottom: 2px #334455;
  border-right: 2px #334455;
}

/* Grid overlay — rendered by SDL, this is a CSS-only approximation */
.stage-grid {
  position: absolute;
  left: 0; top: 0;
  width: 100%; height: 100%;
  background-color: transparent;
}

.stage-coordinate {
  position: absolute;
  right: 6px; top: 6px;
  padding: 3px 7px;
  color: #00d4ff;
  background-color: #000000;
  border-top: 2px #004466;
  border-left: 2px #004466;
  border-bottom: 2px #000000;
  border-right: 2px #000000;
  font-size: 8px;
  letter-spacing: 1px;
}

.stage-coordinate span { color: #88eeff; }

.spawn-badge {
  position: absolute;
  left: 31%;
  bottom: 8px;
  padding: 3px 8px;
  color: #ff7700;
  background-color: #0d0800;
  border-top: 2px #441a00;
  border-left: 2px #441a00;
  border-bottom: 2px #000000;
  border-right: 2px #000000;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1px;
}

.stage-hint {
  position: absolute;
  left: 7px; top: 7px;
  padding: 4px 8px;
  color: #223344;
  background-color: #000000;
  border: 1px #111111;
  font-size: 8px;
  letter-spacing: 1px;
}

.drop-ghost {
  position: absolute;
  left: 50%; top: 50%;
  padding: 6px 12px;
  color: #000000;
  background-color: #00d4ff;
  border-top: 2px #88eeff;
  border-left: 2px #88eeff;
  border-bottom: 2px #005566;
  border-right: 2px #005566;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1px;
}

.drop-ghost.hidden, .hidden { display: none; }

/* ── BOTTOM WORKSPACE STRIP ───────────────────────────────── */
.bottom-workspace {
  height: 86px;
  min-height: 86px;
  display: flex;
  flex-direction: row;
  gap: 3px;
}

.script-flow, .animation-sequencer {
  padding: 6px;
  background-color: #0a0a0a;
  border-top: 2px #223344;
  border-left: 2px #223344;
  border-bottom: 2px #000000;
  border-right: 2px #000000;
}

.script-flow {
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: 0%;
  min-width: 0;
}

.script-flow-items {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 5px;
  padding-top: 6px;
}

/* Script nodes — colored like Image 2's EVENT/ACTION FLOW nodes */
.script-node {
  padding: 5px 8px;
  color: #c8dff5;
  background-color: #0d0d0d;
  border-top: 2px #334455;
  border-left: 2px #334455;
  border-bottom: 2px #000000;
  border-right: 2px #000000;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1px;
}

.trigger-node {
  color: #ffdd00;
  background-color: #110d00;
  border-top-color: #443300;
  border-left-color: #443300;
}

.dialogue-node {
  color: #00d4ff;
  background-color: #001a22;
  border-top-color: #004466;
  border-left-color: #004466;
}

.boss-node {
  color: #ff4455;
  background-color: #110007;
  border-top-color: #440011;
  border-left-color: #440011;
}

.script-arrow {
  color: #334455;
  font-size: 12px;
}

.animation-sequencer {
  width: 240px;
  min-width: 200px;
}

/* ── CAPTIONS / SUBTITLES ─────────────────────────────────── */
.dock-caption {
  color: #ff7700;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 2px;
  margin-bottom: 5px;
  padding-bottom: 3px;
  border-bottom: 1px #221100;
}

.dock-caption span {
  float: right;
  color: #00d4ff;
}

.rail-caption, .property-subtitle {
  color: #ff7700;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 2px;
}

.inspector-divider {
  height: 1px;
  background-color: #1a1a1a;
  margin: 8px 0;
}

/* Timeline ruler/keyframes */
.timeline-ruler {
  position: relative;
  height: 24px;
  background-color: #000000;
  border: 1px #223344;
  margin-bottom: 4px;
}

.timeline-track {
  position: absolute;
  left: 0; right: 0; top: 50%;
  height: 2px;
  background-color: #00d4ff;
}

.timeline-key {
  position: absolute;
  top: 50%;
  width: 8px; height: 8px;
  background-color: #ff7700;
  border-top: 1px #ffbb44;
  border-left: 1px #ffbb44;
  border-bottom: 1px #883300;
  border-right: 1px #883300;
}

.timeline-controls {
  display: flex;
  flex-direction: row;
  gap: 3px;
}

.frame-label { color: #00d4ff; font-size: 8px; letter-spacing: 1px; }

/* ============================================================
   RIGHT DOCK
   ============================================================ */
.right-dock {
  width: 390px;
  min-width: 360px;
  flex-basis: 390px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 0;
  padding: 0;
  background-color: #0a0a0a;
  border-top: 2px #223344;
  border-left: 2px #223344;
  border-bottom: 2px #000000;
  border-right: 2px #000000;
  overflow: hidden;
}

/* Dock tab strip */
.dock-tabs {
  height: 32px;
  min-height: 32px;
  display: flex;
  flex-direction: row;
  gap: 0;
  border-bottom: 2px #000000;
  flex-shrink: 0;
}

.dock-tab {
  flex-grow: 1;
  color: #334455;
  background-color: #0a0a0a;
  border: 0;
  border-right: 1px #111111;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1px;
}

.dock-tab:last-child { border-right: 0; }

.dock-tab.active {
  color: #000000;
  background-color: #ff7700;
}

.dock-tab:hover { color: #c8dff5; background-color: #111111; }

/* Dock panels share this base */
.dock-panel {
  display: flex;
  flex-direction: column;
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: 0%;
  min-height: 0;
  overflow: hidden;
  padding: 8px;
  gap: 7px;
}

.dock-title {
  color: #ff7700;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 2px;
  padding-bottom: 5px;
  border-bottom: 1px #221100;
}

.dock-subtitle {
  color: #334455;
  font-size: 8px;
  font-weight: 400;
  letter-spacing: 1px;
  margin-left: 8px;
}

/* ── ASSET FILTER ROW ─────────────────────────────────────── */
.asset-filter {
  display: flex;
  flex-direction: row;
  gap: 3px;
  flex-shrink: 0;
}

.filter-button {
  padding: 4px 8px;
  color: #334455;
  background-color: #0d0d0d;
  border-top: 1px #334455;
  border-left: 1px #334455;
  border-bottom: 1px #000000;
  border-right: 1px #000000;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1px;
}

.filter-button.active {
  color: #000000;
  background-color: #00d4ff;
  border-top-color: #88eeff;
  border-left-color: #88eeff;
  border-bottom-color: #005566;
  border-right-color: #005566;
}

.filter-button:hover { color: #c8dff5; }

.import-button {
  margin-left: auto;
  color: #ff7700;
  border-top-color: #442200;
  border-left-color: #442200;
}

/* ── FOLDER / ASSET TREE ──────────────────────────────────── */
.folder-scroll {
  width: 100%;
  height: 0;
  min-width: 0;
  min-height: 0;
  flex: 1 1 0%;
  overflow-x: hidden;
  overflow-y: auto;
  overscroll-behavior: contain;
}

.folder {
  border-bottom: 1px #111111;
}

.folder-heading {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 5px;
  padding: 6px 8px;
  color: #667788;
  background-color: #0d0d0d;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1px;
}

.folder-heading:hover {
  color: #c8dff5;
  background-color: #111111;
}

.folder-arrow { color: #334455; font-size: 8px; }

.folder-content {
  width: 100%;
  min-width: 0;
  height: auto;
  padding: 5px;
  background-color: #050505;
}

.folder-subheading {
  color: #334455;
  font-size: 7px;
  letter-spacing: 1px;
  padding: 3px 3px 5px;
}

/* ── ASSET CARDS ──────────────────────────────────────────── */
.asset-card {
  drag: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 4px;
  color: #445566;
  background-color: #0d0d0d;
  border-top: 2px #223344;
  border-left: 2px #223344;
  border-bottom: 2px #000000;
  border-right: 2px #000000;
  font-size: 7px;
  font-weight: 700;
  letter-spacing: 1px;
  text-align: center;
  overflow: hidden;
}

.asset-card:hover {
  color: #c8dff5;
  background-color: #111111;
  border-top-color: #004466;
  border-left-color: #004466;
}

.asset-card.selected {
  color: #000000;
  background-color: #00d4ff;
  border-top-color: #88eeff;
  border-left-color: #88eeff;
  border-bottom-color: #005566;
  border-right-color: #005566;
}

.asset-card-grid {
  width: 100%;
  min-width: 0;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  flex-flow: row wrap;
  align-items: flex-start;
  align-content: flex-start;
  justify-content: flex-start;
  gap: 5px;
  padding: 3px;
}

.asset-card-grid .asset-card {
  width: 86px;
  min-width: 86px;
  max-width: 86px;
  height: 92px;
  min-height: 92px;
  flex: 0 0 86px;
  margin: 0;
}

.tile-card-grid .asset-card {
  width: 86px;
  min-width: 86px;
  max-width: 86px;
  flex: 0 0 86px;
}

.asset-thumb {
  width: 72px;
  min-width: 72px;
  height: 56px;
  background-color: #000000;
  border: 1px #223344;
  margin-bottom: 3px;
}

.asset-tag {
  color: #334455;
  font-size: 7px;
  letter-spacing: 0;
}

/* ── MODEL IMPORT PANEL ──────────────────────────────────── */
.model-import-card {
  overflow-x: hidden;
  overflow-y: auto;
  overscroll-behavior: contain;
}

.model-preview-row {
  display: flex;
  flex-direction: row;
  gap: 8px;
  align-items: flex-start;
  margin-bottom: 8px;
}

.model-preview {
  width: 110px;
  min-width: 110px;
  height: 90px;
  background-color: #000000;
  border-top: 2px #223344;
  border-left: 2px #223344;
  border-bottom: 2px #000000;
  border-right: 2px #000000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.model-preview-placeholder {
  color: #223344;
  font-size: 8px;
  letter-spacing: 1px;
  text-align: center;
}

.model-metrics {
  flex-grow: 1;
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.model-stats {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 4px 6px;
  background-color: #050505;
  border: 1px #111111;
  font-size: 8px;
  color: #445566;
  letter-spacing: 1px;
}

.model-stats strong { color: #c8dff5; }

.model-source-folder, .model-texture-source {
  font-size: 8px;
  color: #334455;
  letter-spacing: 1px;
  padding: 3px 0;
}

.model-animation-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6px;
  font-size: 8px;
  letter-spacing: 1px;
  margin-bottom: 6px;
}

.classification-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  min-height: 34px;
  font-size: 8px;
  letter-spacing: 1px;
}

.classification-row select {
  min-width: 0;
  flex-grow: 1;
  min-height: 28px;
  font-size: 8px;
}

.import-actions {
  display: flex;
  flex-direction: row;
  gap: 5px;
  margin-top: 7px;
}

.import-actions button {
  min-height: 36px;
  font-size: 8px;
  letter-spacing: 1px;
}

.import-actions .import-wide,
.import-actions .place-stage-button {
  flex-grow: 1;
  flex-basis: 0%;
  min-width: 0;
}

.import-texture-button {
  min-height: 32px;
  margin-top: 5px;
  font-size: 8px;
  letter-spacing: 1px;
}

.placement-help {
  margin-top: 7px;
  padding-top: 6px;
  border-top: 1px #111111;
  font-size: 8px;
  color: #334455;
  letter-spacing: 1px;
  line-height: 1.5;
}

/* ── PROPERTY INSPECTOR ──────────────────────────────────── */
.property-inspector {
  overflow-x: hidden;
  overflow-y: auto;
  overscroll-behavior: contain;
}

.property-inspector .property-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  min-height: 34px;
  padding: 4px 0;
  font-size: 9px;
  letter-spacing: 1px;
}

.property-inspector .property-row label {
  width: 110px;
  min-width: 110px;
  flex-shrink: 0;
  font-size: 8px;
  color: #667788;
  letter-spacing: 1px;
}

.property-inspector .property-row select,
.property-inspector .property-row input {
  min-width: 0;
  flex-grow: 1;
  min-height: 26px;
  font-size: 8px;
  letter-spacing: 1px;
  background-color: #000000;
  color: #c8dff5;
  border: 1px #223344;
}

.property-inspector .property-subtitle {
  color: #ff7700;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 2px;
  margin: 10px 0 4px;
  padding-bottom: 3px;
  border-bottom: 1px #221100;
}

.property-inspector .toggle-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 30px;
  padding: 3px 0;
  font-size: 8px;
  color: #667788;
  letter-spacing: 1px;
}

.modern-lock {
  color: #334455;
  font-size: 8px;
  letter-spacing: 1px;
  padding: 5px 0;
  border-top: 1px #111111;
  margin-top: 5px;
}

/* ── ROM SPRITE CLASSIFICATION ───────────────────────────── */
#rom-sprite-classification-row {
  padding: 5px 0;
}

/* ── TILE PAGER ──────────────────────────────────────────── */
.tile-pager {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 4px;
  font-size: 8px;
  color: #445566;
  letter-spacing: 1px;
}

/* ============================================================
   STATUS BAR
   ============================================================ */
.statusbar {
  height: 22px;
  min-height: 22px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 8px;
  background-color: #000000;
  border-top: 2px #ff7700;
  font-size: 8px;
  letter-spacing: 1px;
}

.status-left {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #445566;
}

.status-led {
  width: 7px;
  height: 7px;
  background-color: #00d4ff;
  border-top: 1px #88eeff;
  border-left: 1px #88eeff;
  border-bottom: 1px #004466;
  border-right: 1px #004466;
}

.status-right {
  color: #334455;
  letter-spacing: 1px;
}

/* ============================================================
   MODALS
   ============================================================ */
.modal-shade {
  position: absolute;
  left: 0; top: 0;
  width: 100%; height: 100%;
  background-color: #000000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-shade.hidden { display: none; }

.modal-card {
  background-color: #0a0a0a;
  border-top: 3px #ff7700;
  border-left: 3px #334455;
  border-bottom: 3px #000000;
  border-right: 3px #000000;
  padding: 20px;
  min-width: 360px;
  max-width: 540px;
}

.modal-title {
  color: #ff7700;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 3px;
  margin-bottom: 10px;
  padding-bottom: 8px;
  border-bottom: 1px #221100;
}

.modal-copy {
  font-size: 9px;
  color: #667788;
  letter-spacing: 1px;
  margin-bottom: 14px;
}

.modal-asset-info {
  font-size: 8px;
  color: #445566;
  letter-spacing: 1px;
  margin-bottom: 10px;
  padding: 5px;
  background-color: #000000;
  border: 1px #111111;
}

.classification-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 5px;
  margin-bottom: 14px;
}

/* Classification cards — match Image 2's asset-type buttons */
.class-card {
  flex-grow: 1;
  flex-basis: 42%;
  padding: 10px 8px;
  color: #667788;
  background-color: #0d0d0d;
  border-top: 2px #334455;
  border-left: 2px #334455;
  border-bottom: 2px #000000;
  border-right: 2px #000000;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1px;
  text-align: left;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.class-card:hover {
  color: #c8dff5;
  background-color: #111111;
  border-top-color: #446688;
  border-left-color: #446688;
}

.class-card span {
  color: #334455;
  font-size: 7px;
  font-weight: 400;
  letter-spacing: 0;
}

.boss-class {
  flex-basis: 100%;
  color: #ff4455;
  background-color: #0a0005;
  border-top-color: #440011;
  border-left-color: #440011;
}

.modal-actions {
  display: flex;
  flex-direction: row;
  gap: 5px;
  justify-content: flex-end;
}

/* ============================================================
   SETTINGS DIALOG
   ============================================================ */
.settings-dialog {
  min-width: 480px;
  max-width: 640px;
}

.settings-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 14px;
}

.settings-card {
  flex-grow: 1;
  flex-basis: 44%;
  padding: 10px;
  background-color: #050505;
  border: 1px #111111;
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.settings-note {
  font-size: 8px;
  color: #334455;
  letter-spacing: 1px;
  line-height: 1.5;
}

.mode-choice {
  font-size: 8px;
  letter-spacing: 1px;
  padding: 5px 8px;
}

/* ============================================================
   SCROLLBARS — RmlUi named elements
   ============================================================ */
scrollbarvertical {
  width: 8px;
  background-color: #000000;
}

scrollbarvertical sliderbar {
  width: 6px;
  min-height: 20px;
  margin-left: 1px;
  background-color: #223344;
  border-top: 1px #334455;
  border-left: 1px #334455;
  border-bottom: 1px #000000;
  border-right: 1px #000000;
}

scrollbarhorizontal {
  height: 8px;
  background-color: #000000;
}

scrollbarhorizontal sliderbar {
  height: 6px;
  min-width: 20px;
  margin-top: 1px;
  background-color: #441a00;
  border-top: 1px #663300;
  border-left: 1px #663300;
  border-bottom: 1px #000000;
  border-right: 1px #000000;
}

/* ============================================================
   RESPONSIVE NARROWING
   ============================================================ */
@media (max-width: 1100px) {
  .right-dock {
    width: 340px;
    min-width: 320px;
    flex-basis: 340px;
  }
  .asset-card, .tile-card-grid .asset-card {
    width: 78px;
    min-width: 78px;
    max-width: 78px;
  }
  .asset-thumb, .tile-card .asset-thumb {
    width: 60px;
    min-width: 60px;
  }
  .property-inspector .property-row label {
    width: 96px;
    min-width: 96px;
  }
  .tool-rail {
    width: 80px;
    min-width: 80px;
  }
}

/* ============================================================
   LAYOUT FIXUPS — RmlUi scrolling containers
   ============================================================ */
.dock-panel {
  overflow: hidden;
}

#dock-panel-assets {
  display: flex;
  flex-direction: column;
  width: 100%;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
}

#folder-scroll {
  display: flex;
  flex-direction: column;
  width: 100%;
  min-width: 0;
  min-height: 0;
  height: 0;
  flex: 1 1 0%;
  overflow-x: hidden;
  overflow-y: auto;
}

#folder-scroll .folder {
  width: 100%;
  min-width: 0;
  flex: 0 0 auto;
}

#folder-scroll .folder-content {
  width: 100%;
  min-width: 0;
}

#folder-scroll .asset-card-grid {
  width: 100%;
  min-width: 0;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-start;
  align-content: flex-start;
}

#folder-scroll .asset-card-grid .asset-card {
  flex: 0 0 86px;
  width: 86px;
  min-width: 86px;
  max-width: 86px;
}

.model-import-card,
.property-inspector {
  overflow-x: hidden;
  overflow-y: auto;
  overscroll-behavior: contain;
  scrollbar-margin: 2px;
}

/* These use the Maker's SDL drag controller, never RmlUi drag-drop. */
.asset-card { drag: none; }
